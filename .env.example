# =============================================================================
# WeebCentral Downloader — Environment Variables
# =============================================================================
# Copy this file to .env and customize for your needs.
# All variables are optional — default values are used if not set.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   docker compose up -d
# =============================================================================

# Config File
# -----------
# Path to the TOML configuration file used by the CLI and the watcher.
# Default: config.toml (relative to the working directory)
CONFIG_FILE="config.toml"

# Watcher Mode
# ------------
# Path to the manga list file watched in file-list mode. The watcher downloads
# the list whenever this file changes.
# Default: manga_list.txt (relative to the working directory)
MANGA_LIST="manga_list.txt"

# Set to "true" ("1" and "yes" also work) to watch the SQLite tracked-series
# database instead of a file list. MANGA_LIST is ignored in this mode; the
# watcher runs --tracked and re-checks every check_interval minutes from
# config.toml. Leave empty to keep file-list mode.
#
# Example:
#   WATCH_TRACKED="true"
WATCH_TRACKED=""
