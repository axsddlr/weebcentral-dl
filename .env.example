# =============================================================================
# WeebCentral Downloader — Environment Variables
# =============================================================================
# Copy this file to .env and customize for your needs.
# All variables are optional — default values are used if not set.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   docker compose up -d
# =============================================================================

# API Authentication
# -------------------
# If set, all state-changing API routes (POST/PUT/DELETE) require this token.
# WebSocket connections also require it via ?token= query param.
# Pass it in HTTP requests via the X-API-Token header or ?token= query param.
# Leave empty to disable authentication.
#
# Example:
#   API_TOKEN="my-secret-token"
API_TOKEN=""

# Server
# ------
# Host address for CORS allowlist (used in addition to localhost).
# Set to your server's domain or LAN IP if accessing remotely.
#
# Example:
#   HOST="192.168.1.100"
HOST=""

# Watcher Mode
# ------------
# Path to manga list file for the file-based watcher.
# Default: manga_list.txt (relative to working directory)
MANGA_LIST="manga_list.txt"

# Set to "true" to watch the SQLite-tracked database instead of a file list.
# When enabled, MANGA_LIST is ignored and --tracked mode is used.
WATCH_TRACKED=""

# Config File
# -----------
# Path to the TOML configuration file.
# Default: config.toml (relative to working directory)
CONFIG_FILE="config.toml"
